# Generated by `orobox ci-init` from orobox [[.OroboxVersion]]. Orobox rewrites this file on every
# run, so job improvements reach the project without a manual merge.
#
# Put your own stages, variables, jobs and overrides in [[.RootPath]], which includes this file:
# anything there survives the next `orobox ci-init`.
#
# The jobs use GitLab's default `test` and `deploy` stages, so no `stages:` key is declared here —
# one declared in a file that gets rewritten would fight the list in the including file.

.orobox:
  image: docker:27
  services:
    - docker:27-dind
  variables:
    DOCKER_HOST: tcp://docker:2375
    DOCKER_TLS_CERTDIR: ""
  before_script:
    # git derives the source-upload exclude list from .gitignore. Without it Orobox falls back to a
    # fixed list, and a local vendor/ carrying dev dependencies can then reach the release artifact.
    - apk add --no-cache git
    # Pinned to the version that generated this file; the next `orobox ci-init` re-pins it.
    - wget -qO /usr/local/bin/orobox "https://github.com/algoritma-dev/orobox/releases/download/[[.OroboxVersion]]/orobox_Linux_x86_64"
    - chmod +x /usr/local/bin/orobox
    - orobox --version

orobox:lint:
  extends: .orobox
  stage: test
  script:
    - orobox qa --report=gitlab
  artifacts:
    when: always
    reports:
      codequality: [[.QAReportPath]]
    paths:
      - [[.RawReportsDir]]/

orobox:test:
  extends: .orobox
  stage: test
  script:
    - orobox test --report=gitlab
  artifacts:
    when: always
    reports:
      junit: [[.JUnitReportPath]]
[[range .Stages]]
# --skip-qa --skip-test is sound here and only here: orobox:lint and orobox:test ran the same
# commit against the same cache scope, so repeating them would repeat identical work.
orobox:deploy:[[.Name]]:
  extends: .orobox
  stage: deploy
  script:
    - orobox deploy [[.Name]] --yes --skip-qa --skip-test
  needs: ["orobox:lint", "orobox:test"]
  artifacts:
    paths:
      - [[.ArtifactsPath]]/
  rules:
    # Drop `when: manual` to release on every push to [[.Ref]] instead of on a button.
    - if: $CI_COMMIT_BRANCH == "[[.Ref]]"
      when: manual
[[end]]
