<?php

// Oro deployment recipe, generated by `orobox deploy-init`.
//
// Orobox OVERWRITES this file on every `deploy-init` run so recipe fixes reach existing
// projects. Put project-specific overrides in deploy.php instead.
//
// Host, user, port, path, repository, ref and keep_releases come from the OROBOX_DEPLOY_*
// environment variables that `orobox deploy` injects, so .orobox.yaml stays the single
// source of truth.

namespace Deployer;

// Deployer builds the new release as a symlink named `release` inside deploy_path and, by
// default, makes it relative: `release -> releases/1`. deploy:symlink then moves that symlink
// to current_path with `mv -T`. When current_path sits outside deploy_path — a project served
// from /var/www/vhosts/example.com/shop while deploy_path is
// /var/www/vhosts/example.com/.deployer/shop, say — the relative target no longer resolves from
// the new location and the deploy reports success while current is a dangling symlink. Absolute
// symlinks survive the move, so current is valid wherever it lives.
set('use_relative_symlink', false);

// Directory holding the tarballs built by the Dagger pipeline. `orobox deploy` mounts the
// exported artifacts here inside the Deployer container.
set('orobox_artifact_dir', static fn (): string => getenv('OROBOX_DEPLOY_ARTIFACT_DIR') ?: '/artifacts');

set('orobox_vendor_artifact', '[[.VendorArtifact]]');
set('orobox_assets_artifact', '[[.AssetsArtifact]]');

// Monorepo support: when deploy.source_dir names a subdirectory in .orobox.yaml, `orobox deploy`
// sets OROBOX_DEPLOY_SUB_DIRECTORY and Deployer's archive strategy extracts only that directory
// into the release. The release then looks like a plain Oro checkout, so every path below and in
// deploy.php stays project-relative.
set('sub_directory', static fn (): string|false => getenv('OROBOX_DEPLOY_SUB_DIRECTORY') ?: false);

// Only override Deployer's own PHP detection when the stage explicitly names a binary,
// which remote hosts with several PHP versions installed need.
set('bin/php', static fn (): string => getenv('OROBOX_DEPLOY_PHP') ?: which('php'));

// Every remote console call runs in the production environment, non-interactively.
set('oro_console', static fn (): string => '{{bin/php}} {{release_path}}/bin/console --env=prod --no-interaction');

// To keep development files out of a release, mark them export-ignore in .gitattributes:
//
//     /tests           export-ignore
//     /.orobox.yaml    export-ignore
//
// That works because Deployer checks the code out with `git archive` (update_code_strategy
// defaults to 'archive'), so those files never reach the release at all. Keep the strategy on
// 'archive' if you rely on it.

// Commands that oro:platform:update would run anyway, minus the two migration commands.
// Used when the release carries no new migrations, so changed workflow, cron, process,
// permission and translation definitions still get applied.
set('oro_non_migration_commands', [
    'oro:cron:definitions:load',
    'oro:workflow:definitions:load',
    'oro:process:configuration:load',
    'router:cache:clear',
    'oro:message-queue:create-queues',
    'oro:translation:load',
    'oro:translation:dump',
    'fos:js-routing:dump',
]);

// The permission configuration command was renamed between Oro versions
// (oro:permission:configuration:load on 5.1, security:permission:configuration:load on
// current master), so resolve it from the application's own command list instead of
// branching on a version number.
set('oro_permission_command', static function (): string {
    $available = run('{{oro_console}} list --raw --no-ansi | awk \'{print $1}\'');
    $available = explode("\n", $available);

    foreach (['oro:permission:configuration:load', 'security:permission:configuration:load'] as $candidate) {
        if (in_array($candidate, $available, true)) {
            return $candidate;
        }
    }

    warning('No permission configuration command found in this Oro version; skipping it.');

    return '';
});

// Directories Oro's requirements check demands before it lets oro:platform:update or
// oro:install run (PlatformRequirementsProvider). None of them reach the release on their own:
// var/ and the built public/ directories are gitignored, so `git archive` leaves them out and
// the check fails with 'Change the permissions of the "var/data" directory so that the web
// server can write into it'. They are created by a task rather than through Deployer's
// writable_dirs because deploy.php belongs to the project and orobox never rewrites it.
set('oro_required_dirs', ['var/cache', 'var/logs', 'var/data', 'public/media', 'public/bundles', 'public/js']);

// SHA of every migration file in the release: project migrations plus the ones shipped by
// Oro packages, so an Oro version bump counts as new migrations too. Paths are relative to
// the release, which keeps the checksum comparable between two releases.
set('orobox_migration_checksum_command', 'find src vendor/oro -path "*/Migrations/*" -name "*.php" -type f 2>/dev/null'
    . ' | LC_ALL=C sort | xargs -r sha1sum | sha1sum | cut -d" " -f1');

desc('Upload the artifacts built by the orobox pipeline into the release');
task('oro:upload_artifacts', static function (): void {
    $dir = rtrim(get('orobox_artifact_dir'), '/');

    $vendor = $dir . '/' . get('orobox_vendor_artifact');
    if (!file_exists($vendor)) {
        throw new \RuntimeException(sprintf('Missing required artifact %s', $vendor));
    }

    $artifacts = [$vendor];

    // Present only when pre_built_assets_enabled is false; otherwise the repository already
    // carries the built assets.
    $assets = $dir . '/' . get('orobox_assets_artifact');
    if (file_exists($assets)) {
        $artifacts[] = $assets;
    } else {
        info('No assets artifact for this stage: assets come from the repository.');
    }

    foreach ($artifacts as $artifact) {
        $name = basename($artifact);
        upload($artifact, '{{release_path}}/' . $name);
        run('cd {{release_path}} && tar -xzf ' . $name . ' && rm -f ' . $name);
        info(sprintf('Extracted %s', $name));
    }
});

desc('Create the directories Oro requires to be writable');
task('oro:required_dirs', static function (): void {
    // mkdir -p accepts a shared directory that deploy:shared already turned into a symlink,
    // so a project keeping var/data or public/media in shared_dirs stays untouched here.
    run('cd {{release_path}} && mkdir -p ' . implode(' ', get('oro_required_dirs')));
});

desc('Update the application, skipping oro:platform:update when no migrations changed');
task('oro:update', static function (): void {
    if (orobox_has_new_migrations()) {
        info('New migrations detected: running oro:platform:update.');
        run('{{oro_console}} oro:platform:update --force', ['timeout' => null]);

        return;
    }

    info('No new migrations: running the non-migration update commands.');

    $commands = get('oro_non_migration_commands');
    if ($permission = get('oro_permission_command')) {
        array_unshift($commands, $permission);
    }

    foreach ($commands as $command) {
        run('{{oro_console}} ' . $command, ['timeout' => null]);
    }
});

desc('Install the assets that are served directly');
task('oro:assets_install', static function (): void {
    // Never oro:assets:install here: webpack either ran in the pipeline or the repository
    // ships pre-built assets. This only copies bundle public directories into public/bundles.
    run('{{oro_console}} assets:install', ['timeout' => null]);
});

desc('Warm up the application cache');
task('oro:cache_warmup', static function (): void {
    run('{{oro_console}} cache:warmup', ['timeout' => null]);
});

desc('Restart consumers and cron on the remote host');
task('oro:restart', static function (): void {
    $command = getenv('OROBOX_DEPLOY_RESTART_COMMAND');
    if (!$command) {
        info('No restart_command configured for this stage.');

        return;
    }

    run($command, ['timeout' => null]);
});

desc('Remove every trace of a failed release');
task('oro:cleanup_failed', static function (): void {
    $release = get('release_name');

    // Point current back at the previous release before deleting anything, so the site is
    // never served from a directory that is about to disappear.
    $fallback = (string) max(0, ((int) $release) - 1);
    if (has('previous_release')) {
        $fallback = basename((string) get('previous_release'));
    }

    if ($fallback !== '0') {
        run('if [ -d {{deploy_path}}/releases/' . $fallback . ' ]; then '
            . 'ln -sfn {{deploy_path}}/releases/' . $fallback . ' {{current_path}}; fi');
    }

    run('rm -rf {{deploy_path}}/releases/' . $release);
    run('rm -f {{deploy_path}}/release {{deploy_path}}/.dep/deploy.lock');

    // Drop the failed release from Deployer's bookkeeping so the next deploy does not reuse
    // its number and the migration diff keeps comparing against a real previous release.
    run('if [ -f {{deploy_path}}/.dep/releases_log ]; then '
        . 'grep -v \'"release_name":"' . $release . '"\' {{deploy_path}}/.dep/releases_log '
        . '> {{deploy_path}}/.dep/releases_log.tmp || true; '
        . 'mv {{deploy_path}}/.dep/releases_log.tmp {{deploy_path}}/.dep/releases_log; fi');
    run('echo ' . $fallback . ' > {{deploy_path}}/.dep/latest_release');

    warning(sprintf('Deploy failed: release %s was removed and current points at release %s.', $release, $fallback));
});

/**
 * Reports whether the new release contains migrations the previous one did not.
 *
 * A first deploy, or a missing previous release, always counts as new migrations: there is
 * nothing to compare against and a full oro:platform:update is the safe answer.
 */
function orobox_has_new_migrations(): bool
{
    $checksum = get('orobox_migration_checksum_command');

    // current still points at the previous release: the symlink is swapped later, in
    // deploy:publish. Testing the symlink itself avoids readlink echoing back a dangling path.
    $previous = trim(run('if [ -L {{current_path}} ]; then readlink -f {{current_path}}; fi'));
    if ($previous === '') {
        info('No previous release found.');

        return true;
    }

    $previousSum = trim(run('cd ' . $previous . ' && ' . $checksum));
    $currentSum = trim(run('cd {{release_path}} && ' . $checksum));

    return $previousSum !== $currentSum;
}

desc('Deploy the Oro application');
task('deploy', [
    'deploy:prepare',
    'oro:upload_artifacts',
    'oro:required_dirs',
    'oro:update',
    'oro:assets_install',
    'oro:cache_warmup',
    'deploy:publish',
    'oro:restart',
]);

fail('deploy', 'oro:cleanup_failed');
